# Optional. Defaults to the current working directory.
OPENGATES_CONFIG_DIR=
# Optional. Defaults to ./gates if present, otherwise the bundled starter gate.
OPENGATES_GATES_DIR=
# Optional. Defaults to ./data
OPENGATES_DATA_DIR=

OPENGATES_PROVIDER=heuristic
OPENAI_API_KEY=
OPENGATES_OPENAI_MODEL=gpt-5-mini
OPENGATES_DEBUG_PROMPTS=0

OPENGATES_SMTP_HOST=
OPENGATES_SMTP_PORT=587
OPENGATES_SMTP_USERNAME=
OPENGATES_SMTP_PASSWORD=
OPENGATES_SMTP_USE_TLS=1
OPENGATES_SMTP_USE_SSL=0
OPENGATES_NOTIFICATION_FROM_EMAIL=
OPENGATES_NOTIFICATION_FROM_NAME=OpenGates
